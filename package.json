{
  "name": "git-monitor",
  "version": "1.2.58",
  "description": "Mini widget desktop para monitorar repositórios Git em tempo real",
  "main": "main.js",
  "author": {
    "name": "Rony Drop",
    "url": "https://github.com/ronydrop"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ronydrop/git-monitor"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/commit-message.test.js && node tests/deploy-status.test.js && node tests/git-sync.test.js && node tests/config-store.test.js && node tests/github-auth.test.js && node tests/release-pipeline.test.js && node tests/ui-behavior.test.js",
    "build": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis",
    "release": "electron-builder --win portable nsis --publish always",
    "version:patch": "npm version patch && git push && git push --tags",
    "version:minor": "npm version minor && git push && git push --tags",
    "version:major": "npm version major && git push && git push --tags"
  },
  "build": {
    "appId": "com.rony.git-monitor",
    "productName": "Git Monitor",
    "files": [
      "main.js",
      "config-store.js",
      "commit-message.js",
      "deploy-status.js",
      "github-auth.js",
      "git-sync.js",
      "repo-state.js",
      "index.html",
      "config.html",
      "diff.html",
      "notch.html",
      "toast.html",
      "zone-select.html",
      "themes.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "GitMonitor-portable.exe"
    },
    "nsis": {
      "artifactName": "GitMonitor-Setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Git Monitor",
      "uninstallDisplayName": "Git Monitor"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.botjarvis.com.br/git-monitor/"
    }
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.77.0",
    "electron-updater": "^6.8.3",
    "openai": "^6.23.0"
  }
}
